digraph NFA {
    rankdir=LR;
    start [shape=none,label=""];
    start -> AND;

    node [shape=circle];

    q0 [shape=doublecircle];
    q2 [shape=doublecircle];
    s0 [shape=doublecircle];
    s1 [shape=doublecircle];
    s2 [shape=doublecircle];
    s3 [shape=doublecircle];
    AND [shape=rectangle];

    AND -> s0 [label="ε"];
    s0 -> s1 [label="a"];
    s0 -> s0 [label="b"];
    s1 -> s2 [label="b"];
    s1 -> s1 [label="a"];
    s2 -> s3 [label="a"];
    s2 -> s0 [label="b"];
    s3 -> s4 [label="b"];
    s3 -> s1 [label="a"];
    s4 -> s5 [label="a"];
    s4 -> s0 [label="b"];
    s5 -> s6 [label="b"];
    s6 -> s0 [label="b"];

    AND -> q0 [label="ε"];
    q0 -> q1 [label="a"];
    q0 -> q3 [label="a,b"];
    q0 -> q0 [label="b"];
    q1 -> q2 [label="a"];
    q1 -> q1 [label="b"];
    q2 -> q1 [label="a"];
    q2 -> q3 [label="a,b"];
    q3 -> q4 [label="a"];
    q4 -> q5 [label="b"];
    q5 -> q2 [label="b"];
}
