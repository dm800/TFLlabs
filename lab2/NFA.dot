digraph NFA {
    rankdir=LR;
    start [shape=none,label=""];
    start -> q0;

    node [shape=circle];

    q0 [shape=doublecircle];
    q2 [shape=doublecircle];

    q0 -> q1 [label="a"];
    q0 -> q3 [label="a,b"];
    q0 -> q0 [label="b"];
    q1 -> q2 [label="a"];
    q1 -> q1 [label="b"];
    q2 -> q1 [label="a"];
    q2 -> q3 [label="a,b"];
    q3 -> q4 [label="a"];
    q4 -> q5 [label="b"];
    q5 -> q2 [label="b"];
}
